{
  "name": "@refraction/editor",
  "description": "The main application for Refraction's editor",
  "version": "4.4.0",
  "private": false,
  "author": "Refraction Team",
  "homepage": "https://github.com/kohid/refraction",
  "license": "GPL-3.0-or-later",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kohid/refraction.git",
    "directory": "packages/core/editor"
  },
  "bugs": {
    "url": "https://github.com/kohid/refraction/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "/dist",
    "/src",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsup --config=../../tsup.build.ts",
    "dev": "tsup --config=../../tsup.dev.ts"
  },
  "dependencies": {
    "@refraction/editor-current-user": "4.4.0",
    "@refraction/editor-v1-adapters": "4.4.0",
    "@refraction/locations": "4.4.0",
    "@refraction/query": "4.4.0",
    "@refraction/store": "4.4.0",
    "@elementor/ui": "1.41.3",
    "@refraction/editor-ui": "4.4.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
