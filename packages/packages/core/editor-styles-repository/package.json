{
  "name": "@refraction/editor-styles-repository",
  "description": "Refraction Editor Styles Repository",
  "version": "4.4.0",
  "private": false,
  "author": "Refraction Team",
  "homepage": "https://github.com/kohid/refraction",
  "license": "GPL-3.0-or-later",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kohid/refraction.git",
    "directory": "packages/core/editor-styles-repository"
  },
  "bugs": {
    "url": "https://github.com/kohid/refraction/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config=../../tsup.build.ts",
    "dev": "tsup --config=../../tsup.dev.ts"
  },
  "dependencies": {
    "@refraction/editor-current-user": "4.4.0",
    "@refraction/editor-elements": "4.4.0",
    "@refraction/editor-props": "4.4.0",
    "@refraction/editor-styles": "4.4.0",
    "@refraction/editor-v1-adapters": "4.4.0",
    "@refraction/schema": "4.4.0",
    "@refraction/utils": "4.4.0",
    "@wordpress/i18n": "^5.13.0"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
