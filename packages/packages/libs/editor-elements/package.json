{
  "name": "@refraction/editor-elements",
  "description": "This package contains the elements model for the Refraction editor",
  "version": "4.4.0",
  "private": false,
  "author": "Refraction Team",
  "homepage": "https://github.com/kohid/refraction",
  "license": "GPL-3.0-or-later",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kohid/refraction.git",
    "directory": "packages/libs/editor-elements"
  },
  "bugs": {
    "url": "https://github.com/kohid/refraction/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "/dist",
    "/src",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsup --config=../../tsup.build.ts",
    "dev": "tsup --config=../../tsup.dev.ts"
  },
  "dependencies": {
    "@refraction/editor-mcp": "4.4.0",
    "@refraction/editor-props": "4.4.0",
    "@refraction/editor-styles": "4.4.0",
    "@refraction/editor-v1-adapters": "4.4.0",
    "@refraction/schema": "4.4.0",
    "@refraction/session": "4.4.0",
    "@refraction/utils": "4.4.0",
    "@wordpress/i18n": "^3.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
