{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": { "php": "7.4", "wp": "latest" },
    "features": {
        "networking": true
    },
    "extraLibraries": [ "wp-cli" ],
	"steps": [
		{ "step": "login", "username": "admin", "password": "password" },
		{
            "step": "defineWpConfigConsts",
            "consts": {
                "WP_DISABLE_FATAL_ERROR_HANDLER": true,
                "WP_DEBUG": true,
                "WP_DEBUG_DISPLAY": true,
                "SCRIPT_DEBUG": true,
                "REFRACTION_SHOW_HIDDEN_EXPERIMENTS": true
            }
        },
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "hello-elementor"
			}
		},
		{ "step": "activatePlugin", "pluginPath": "/wordpress/wp-content/plugins/refraction" },
        { "step": "activateTheme", "themeFolderName": "hello-elementor" },
        { "step": "wp-cli", "command": "wp option add 'refraction_onboarded' 1" },
        { "step": "wp-cli", "command": "wp refraction experiments activate container" },
        { "step": "updateUserMeta", "meta": { "announcements_user_counter": 999, "refraction_enable_ai": 0, "_e_welcome_popover_displayed": 1 }, "userId": 1 },
        {
            "step": "wp-cli",
            "command": "wp --user=admin refraction library import-dir /wordpress/wp-content/plugins/refraction/tests/playwright/templates || echo 'Template import failed or already imported'"
        }
	]
}